<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Hech narsa backup qilinmaydi -->
        <!-- Encrypted secrets: their Keystore key never leaves this phone, so a copy is useless -->
        <exclude domain="sharedpref" path="tikoncha_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Hech narsa transfer qilinmaydi -->
        <exclude domain="sharedpref" path="tikoncha_secure.xml" />
    </device-transfer>
</data-extraction-rules>
